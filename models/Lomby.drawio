        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass User {\n  - userId : String\n  - username : String\n  - email : String\n  + createAccount() : void\n  + login() : boolean\n}\n\nclass Member {\n  - membershipDate : Date\n  + browseLibrary() : List&lt;Game&gt;\n  + borrowGame(game : Game) : Loan\n  + returnGame(loan : Loan) : void\n}\n\nclass Admin {\n  - employeeId : String\n  + addGame(game : Game) : void\n  + removeGame(gameId : String) : void\n  + updateGameStatus(gameId : String, status : GameStatus) : void\n}\n\nclass Game {\n  - gameId : String\n  - title : String\n  - genre : String\n  - platform : String\n  - releaseYear : int\n  - isAvailable : boolean\n  + checkAvailability() : boolean\n  + updateStatus(status : boolean) : void\n}\n\nclass Loan {\n  - loanId : String\n  - loanDate : Date\n  - dueDate : Date\n  - returnDate : Date\n  - status : LoanStatus\n  + calculateDueDate() : Date\n  + completeLoan() : void\n}\n\nenum LoanStatus {\n  ACTIVE\n  RETURNED\n  OVERDUE\n}\n\nUser &lt;|-- Member\nUser &lt;|-- Admin\nMember \&quot;1\&quot; -- \&quot;0..*\&quot; Loan : has &gt;\nLoan \&quot;0..*\&quot; -- \&quot;1\&quot; Game : involves &gt;\nAdmin \&quot;1\&quot; -- \&quot;0..*\&quot; Game : manages &gt;\nLoan ..&gt; LoanStatus\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YMoya_p60mmCYvo5XkgV-1">
